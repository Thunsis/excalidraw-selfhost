# ============================================================
# excalidraw-selfhost 配置模板
# 用法: cp .env.example .env → 填你的值 → ./install.sh
# ============================================================

# ── 前端（Excalidraw 官方 repo 位置，install 会打补丁并 build）──
# 指向官方 excalidraw monorepo 的本地 clone（含 excalidraw-app/build 产物）
EXCALIDRAW_REPO_DIR=/path/to/excalidraw

# ── 端口 ──
CADDY_PORT=3001
WS_PORT=3020
AI_PORT=3016

# ── 对外域名（cloudflared tunnel 入口）──
DOMAIN=draw.example.com
# 可选第二个域名（www 等），留空跳过
DOMAIN_ALT=

# ── Cloudflare Tunnel（留空 = 不启用 tunnel，仅本地 HTTPS）──
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CREDENTIALS_FILE=

# ── ws 后端数据（SQLite）──
# 默认: <repo>/backend/data/workspace.db
WS_DATA_DIR=
# JWT secret 文件（默认: <repo>/backend/data/.jwt-secret）
JWT_SECRET_FILE=

# ── AI 后端（text-to-diagram）──
# API key 来源: 优先 OPENAI_API_KEY，否则 OPENAI_CONFIG_FILE 里的
# openai_api_key / opencode-go.api_key（默认 ~/.hermes/config.yaml）
OPENAI_API_KEY=
OPENAI_CONFIG_FILE=
# 模型（默认 deepseek-v4-flash）
MODEL=
# OpenAI 兼容端点（默认 https://opencode.ai/zen/go/v1）
OPENAI_BASE=

# ── 系统路径（macOS launchd）──
# 生成 plist 的安装目录（默认 ~/Library/LaunchAgents）
LAUNCH_AGENTS_DIR=
# cloudflared 配置目录（默认 ~/.cloudflared）
CLOUDFLARED_DIR=
